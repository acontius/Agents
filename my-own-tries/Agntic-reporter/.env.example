# Database (used by local runs; Docker Compose overrides this)
DATABASE_URL=postgresql+psycopg://report_agent:report_agent_password@localhost:5434/daily_reports

# OpenRouter (required for LLM features)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free

# Optional: Gradio server settings
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
